---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { 
  ShoppingBag, Users, Package, Ticket, 
  Truck, CreditCard, ArrowRight, TrendingUp,
  AlertCircle, CheckCircle2
} from 'lucide-react';

// Estos datos luego los traerás de endpoints tipo "/stats/summary" en NestJS
const summary = [
  { 
    name: 'Productos', 
    count: '1,240', 
    detail: '12 sin stock', 
    icon: ShoppingBag, 
    href: '/dashboard/products',
    color: 'text-blue-600',
    bg: 'bg-blue-100'
  },
  { 
    name: 'Pedidos Hoy', 
    count: '45', 
    detail: '$2,840.00 total', 
    icon: Package, 
    href: '/dashboard/orders',
    color: 'text-emerald-600',
    bg: 'bg-emerald-100'
  },
  { 
    name: 'Usuarios', 
    count: '8,200', 
    detail: '15 nuevos hoy', 
    icon: Users, 
    href: '/dashboard/users',
    color: 'text-purple-600',
    bg: 'bg-purple-100'
  },
  { 
    name: 'Cupones Activos', 
    count: '8', 
    detail: '2 expiran pronto', 
    icon: Ticket, 
    href: '/dashboard/coupons',
    color: 'text-amber-600',
    bg: 'bg-amber-100'
  },
];

const recentActivity = [
  { type: 'order', msg: 'Nuevo pedido de Ana López', time: 'Hace 2 min', status: 'success' },
  { type: 'user', msg: 'Nuevo usuario registrado', time: 'Hace 15 min', status: 'info' },
  { type: 'stock', msg: 'iPhone 15 Pro se quedó sin stock', time: 'Hace 1 hora', status: 'warning' },
];
---

<DashboardLayout title="Inicio | Dashboard">
  <div class="space-y-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-slate-800 tracking-tight">Panel de Resumen</h1>
        <p class="text-slate-500 font-medium">Bienvenido al control central de tu Tienda Online.</p>
      </div>
      <div class="px-4 py-2 bg-white border border-slate-200 rounded-2xl flex items-center gap-3 shadow-sm">
        <div class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
        <span class="text-sm font-bold text-slate-600">API NestJS: Online</span>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {summary.map((item) => (
        <a href={item.href} class="group bg-white p-6 rounded-3xl border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
          <div class="flex justify-between items-start mb-4">
            <div class={`p-3 rounded-2xl ${item.bg} ${item.color}`}>
              <item.icon size={24} />
            </div>
            <ArrowRight size={20} class="text-slate-300 group-hover:text-slate-600 group-hover:translate-x-1 transition-all" />
          </div>
          <div>
            <h3 class="text-slate-500 text-sm font-bold uppercase tracking-wider">{item.name}</h3>
            <p class="text-3xl font-black text-slate-800 mt-1">{item.count}</p>
            <p class="text-xs font-medium text-slate-400 mt-2 flex items-center gap-1">
              <TrendingUp size={12} /> {item.detail}
            </p>
          </div>
        </a>
      ))}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 space-y-6">
        <h2 class="text-xl font-bold text-slate-800 flex items-center gap-2">
          <CheckCircle2 size={24} class="text-blue-500" /> Estado de Configuración
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="bg-slate-900 p-6 rounded-3xl text-white relative overflow-hidden group">
            <CreditCard size={80} class="absolute -right-4 -bottom-4 text-white/5 group-hover:rotate-12 transition-transform" />
            <h4 class="font-bold text-lg mb-1">Pagos e Impuestos</h4>
            <p class="text-slate-400 text-xs mb-4">IVA al 16% y Stripe activos.</p>
            <a href="/dashboard/payments" class="text-sm font-bold text-blue-400 hover:underline">Revisar tasas →</a>
          </div>
          <div class="bg-white p-6 rounded-3xl border border-slate-200 flex flex-col justify-between">
            <div>
              <h4 class="font-bold text-slate-800 text-lg mb-1">Logística</h4>
              <p class="text-slate-400 text-xs">3 zonas de envío configuradas.</p>
            </div>
            <a href="/dashboard/shipping" class="mt-4 inline-block bg-slate-100 text-slate-600 text-center py-2 rounded-xl text-sm font-bold hover:bg-slate-200 transition-colors">
              Gestionar Envíos
            </a>
          </div>
        </div>
      </div>

      <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm">
        <h2 class="text-xl font-bold text-slate-800 mb-6">Actividad Directa</h2>
        <div class="space-y-6">
          {recentActivity.map((act) => (
            <div class="flex gap-4 relative">
              <div class={`w-10 h-10 rounded-full flex items-center justify-center shrink-0 ${
                act.status === 'success' ? 'bg-green-100 text-green-600' : 
                act.status === 'warning' ? 'bg-amber-100 text-amber-600' : 'bg-blue-100 text-blue-600'
              }`}>
                {act.status === 'warning' ? <AlertCircle size={20}/> : <TrendingUp size={20}/>}
              </div>
              <div class="border-b border-slate-50 pb-4 w-full">
                <p class="text-sm font-bold text-slate-800">{act.msg}</p>
                <p class="text-xs text-slate-400 mt-1">{act.time}</p>
              </div>
            </div>
          ))}
        </div>
        <button class="w-full mt-4 py-3 text-sm font-bold text-slate-500 hover:text-slate-800 transition-colors">
          Ver todos los logs
        </button>
      </div>
    </div>
  </div>
</DashboardLayout>
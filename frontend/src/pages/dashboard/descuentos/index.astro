---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { BadgePercent, Clock, Tag, Plus } from 'lucide-react';

const discounts = [
  { id: 1, name: "Oferta de Primavera", value: "15%", target: "Categoría: Ropa", start: "20 Mar", end: "20 Abr", status: "Programado" },
  { id: 2, name: "Liquidación Stock", value: "30%", target: "Todo el catálogo", start: "01 Mar", end: "15 Mar", status: "Activo" },
];
---

<DashboardLayout title="Descuentos Automáticos">
  <div class="space-y-6">
    <div class="flex justify-between items-center">
      <div>
        <h1 class="text-2xl font-bold text-slate-800">Descuentos Automáticos</h1>
        <p class="text-slate-500 text-sm">Reglas de precio que se aplican sin necesidad de cupones.</p>
      </div>
      <button class="bg-rose-600 text-white px-4 py-2 rounded-xl hover:bg-rose-700 transition-all font-semibold flex items-center gap-2">
        <Plus size={18} /> Crear Descuento
      </button>
    </div>

    <div class="grid gap-4">
      {discounts.map((d) => (
        <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between group hover:border-rose-200 transition-all">
          <div class="flex items-center gap-4">
            <div class="p-3 bg-rose-50 text-rose-600 rounded-2xl group-hover:bg-rose-600 group-hover:text-white transition-colors">
              <BadgePercent size={24} />
            </div>
            <div>
              <h3 class="font-bold text-slate-800 text-lg">{d.name}</h3>
              <div class="flex items-center gap-3 text-sm text-slate-400">
                <span class="flex items-center gap-1 font-medium text-rose-600"><Tag size={14} /> {d.value} OFF</span>
                <span class="flex items-center gap-1"><Clock size={14} /> {d.start} - {d.end}</span>
              </div>
            </div>
          </div>
          <div class="flex items-center gap-6">
            <span class="text-sm font-semibold text-slate-500">{d.target}</span>
            <span class={`px-3 py-1 rounded-full text-xs font-bold ${d.status === 'Activo' ? 'bg-green-100 text-green-700' : 'bg-blue-100 text-blue-700'}`}>
              {d.status.toUpperCase()}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</DashboardLayout>
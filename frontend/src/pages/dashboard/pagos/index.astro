---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { CreditCard, CheckCircle2, AlertCircle, ExternalLink } from 'lucide-react';

const payments = [
  { id: "PAY-9921", method: "Stripe (Visa)", amount: 125.00, customer: "l.jimenez@email.com", date: "Hace 5 min", status: "Completado" },
  { id: "PAY-9920", method: "PayPal", amount: 45.50, customer: "m.rocas@email.com", date: "Hace 2 hrs", status: "Fallido" },
];
---

<DashboardLayout title="Pagos">
  <div class="space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-gradient-to-br from-slate-800 to-slate-900 p-6 rounded-2xl text-white shadow-lg">
        <p class="text-slate-400 text-sm font-medium">Balance en Pasarela</p>
        <h2 class="text-3xl font-bold mt-1">$4,250.80</h2>
        <button class="mt-4 text-xs bg-white/10 hover:bg-white/20 px-3 py-1.5 rounded-lg transition-colors">Retirar fondos</button>
      </div>
      <div class="bg-white p-6 rounded-2xl border border-slate-200 flex items-center gap-4">
         <div class="p-3 bg-blue-50 text-blue-600 rounded-xl"><CreditCard size={24} /></div>
         <div>
           <p class="text-slate-500 text-sm font-medium">Método Principal</p>
           <p class="font-bold text-slate-800">Stripe v3.0</p>
         </div>
      </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
      <div class="p-5 border-b border-slate-100 font-bold text-slate-700">Transacciones Recientes</div>
      <table class="w-full text-left">
        <tbody class="divide-y divide-slate-50">
          {payments.map((p) => (
            <tr class="hover:bg-slate-50/50 transition-colors">
              <td class="px-6 py-4">
                <p class="text-sm font-bold text-slate-800">{p.id}</p>
                <p class="text-xs text-slate-400">{p.method}</p>
              </td>
              <td class="px-6 py-4 text-sm text-slate-600 font-medium">{p.customer}</td>
              <td class="px-6 py-4 font-bold text-slate-700">${p.amount.toFixed(2)}</td>
              <td class="px-6 py-4">
                <span class={`flex items-center gap-1 text-xs font-bold ${p.status === 'Completado' ? 'text-green-600' : 'text-red-500'}`}>
                  {p.status === 'Completado' ? <CheckCircle2 size={14}/> : <AlertCircle size={14}/>} {p.status}
                </span>
              </td>
              <td class="px-6 py-4 text-right">
                <button class="text-slate-400 hover:text-blue-600"><ExternalLink size={18}/></button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</DashboardLayout>
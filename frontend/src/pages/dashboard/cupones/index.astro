---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { Ticket, Calendar, Zap, Scissors } from 'lucide-react';

const coupons = [
  { code: "BIENVENIDA20", discount: "20%", type: "Porcentaje", expiry: "31 Dic 2026", usage: "45/100" },
  { code: "VERANO50", discount: "$50.00", type: "Fijo", expiry: "15 Ago 2026", usage: "12/50" },
];
---

<DashboardLayout title="Cupones">
  <div class="space-y-6">
    <div class="flex justify-between items-center">
      <h1 class="text-2xl font-bold text-slate-800 tracking-tight">Cupones de Descuento</h1>
      <button class="bg-indigo-600 text-white px-4 py-2 rounded-xl hover:bg-indigo-700 transition-all font-semibold flex items-center gap-2">
        <Ticket size={18} /> Crear Cupón
      </button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {coupons.map((coupon) => (
        <div class="bg-white border-2 border-dashed border-slate-200 rounded-2xl p-6 flex justify-between items-center hover:border-indigo-300 transition-colors group">
          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <span class="bg-indigo-50 text-indigo-700 px-3 py-1 rounded-lg font-mono font-bold text-lg border border-indigo-100">
                {coupon.code}
              </span>
              <span class="text-green-600 font-bold text-xl">{coupon.discount} OFF</span>
            </div>
            <div class="flex items-center gap-4 text-sm text-slate-400">
              <span class="flex items-center gap-1"><Calendar size={14} /> Expira: {coupon.expiry}</span>
              <span class="flex items-center gap-1"><Zap size={14} /> Usos: {coupon.usage}</span>
            </div>
          </div>
          <button class="p-3 bg-slate-50 text-slate-400 rounded-xl group-hover:bg-indigo-600 group-hover:text-white transition-all">
            <Scissors size={20} />
          </button>
        </div>
      ))}
    </div>
  </div>
</DashboardLayout>
---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { ReceiptText, Globe2, Edit2, AlertCircle } from 'lucide-react';

const taxes = [
  { region: "IVA General (México)", rate: "16%", type: "Ventas", active: true },
  { region: "IVA Fronterizo", rate: "8%", type: "Ventas", active: true },
  { region: "Retención ISR", rate: "1.1%", type: "Servicios", active: false },
];
---

<DashboardLayout title="Impuestos">
  <div class="max-w-4xl space-y-6">
    <div class="flex justify-between items-center">
      <h1 class="text-2xl font-bold text-slate-800 tracking-tight">Configuración Fiscal</h1>
      <button class="bg-slate-900 text-white px-4 py-2 rounded-xl text-sm font-bold hover:bg-slate-800">Añadir Tasa</button>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm">
      {taxes.map((t) => (
        <div class="p-6 flex items-center justify-between border-b last:border-0 border-slate-100">
          <div class="flex items-center gap-4">
            <div class="p-3 bg-slate-50 text-slate-500 rounded-xl"><ReceiptText size={20} /></div>
            <div>
              <p class="font-bold text-slate-800">{t.region}</p>
              <p class="text-xs text-slate-400">Tipo: {t.type}</p>
            </div>
          </div>
          <div class="flex items-center gap-8">
            <div class="text-right">
              <p class="text-2xl font-mono font-bold text-slate-700">{t.rate}</p>
              <p class="text-[10px] uppercase tracking-widest text-slate-400 font-bold">Tasa Aplicada</p>
            </div>
            <button class="p-2 hover:bg-slate-100 rounded-lg transition-colors text-slate-400 hover:text-slate-600">
              <Edit2 size={18} />
            </button>
          </div>
        </div>
      ))}
    </div>

    <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 flex gap-4 items-start">
      <AlertCircle className="text-amber-600 mt-1" size={20} />
      <div>
        <h4 class="font-bold text-amber-800">Nota Fiscal</h4>
        <p class="text-sm text-amber-700/80 leading-relaxed mt-1">
          Estas tasas se aplicarán automáticamente al finalizar la compra (Checkout). Asegúrate de que coincidan con la regulación vigente de tu país para evitar discrepancias en la facturación con NestJS.
        </p>
      </div>
    </div>
  </div>
</DashboardLayout>